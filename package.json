{
  "name": "discord-bot",
  "version": "2.0.0",
  "description": "Discord bot: slash commands for everyone, prefix dev commands for owner only",
  "main": "index.js",
  "scripts": {
    "start": "node .",
    "music": "cd NodeLink && npm start",
    "dev": "concurrently --kill-others-on-fail --names \"BOT,NODELINK\" --prefix-colors \"cyan,magenta\" \"npm start\" \"npm run music\""
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@distube/ytdl-core": "^4.16.12",
    "@napi-rs/canvas": "^1.0.9",
    "@supabase/supabase-js": "^2.45.0",
    "concurrently": "^10.0.5",
    "discord.js": "^14.16.0",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "moonlink.js": "^5.2.0",
    "opusscript": "^0.0.8",
    "yt-search": "^2.13.1",
    "ytube-noapi": "^1.0.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
